{
  "name": "portfolio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "node src/app/openapi/generate-openapi.js && vite build",
    "preview": "vite preview --host",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:seed": "npx tsx --env-file=.env src/db/commands/seeder.ts"
  },
  "dependencies": {
    "@scalar/sveltekit": "^0.2.14",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/svelte-query": "^6.1.30",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hashids": "^2.3.0",
    "i18next": "^26.0.6",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9",
    "prettier": "^3.8.1",
    "svelte": "^5.55.2",
    "swagger-jsdoc": "^6.2.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "winston": "^3.19.0",
    "zod": "^4.3.6",
    "zod-i18n-map": "^2.27.0"
  },
  "devDependencies": {
    "@types/swagger-jsdoc": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte-check": "^4.4.6"
  }
}
